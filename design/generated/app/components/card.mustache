{{! Generated by Vyasa UX Studio from the project's design system; change the design system and regenerate rather than editing this file. }}
<div class="card">
  {{#header}}<div class="card-header">{{header}}</div>{{/header}}
  {{#image}}<img src="{{image}}" class="card-img-top" alt="{{imageAlt}}">{{/image}}
  <div class="card-body">
    {{#title}}<h5 class="card-title">{{title}}</h5>{{/title}}
    {{#subtitle}}<h6 class="card-subtitle mb-2 text-body-secondary">{{subtitle}}</h6>{{/subtitle}}
    {{#text}}<p class="card-text">{{text}}</p>{{/text}}
    {{> children}}
  </div>
  {{#footer}}<div class="card-footer text-body-secondary">{{footer}}</div>{{/footer}}
</div>
